{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vectorizer",
  "version": "0.1.0",
  "identifier": "net.xixlabs.vectorizer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vectorizer by XIXLabs.net",
        "width": 300,
        "height": 600,
        "minWidth": 300,
        "maxWidth": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": ["pngtosvg-runtime/", "tor-runtime/"]
  }
}
